NODE_ENV=production
PORT=10000
TRUST_PROXY=true

# Supabase PostgreSQL. Sustituye [YOUR-PASSWORD] por la password real.
DATABASE_URL=postgresql://postgres.nffydeuscsyzhqpxhafu:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_REQUIRED=true
DB_LOGGING=false
WEBHOOK_AUDIT_ENABLED=true

# Frontend Vercel autorizado.
CORS_ORIGINS=https://plantillas-ia-chapucero-test.vercel.app
COOKIE_DOMAIN=
COOKIE_SECURE=true
CSRF_REQUIRED=true
REQUIRE_AUTH_FOR_API=true

# Sustituir por dos secretos largos y distintos antes de desplegar.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_render_test
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_render_test
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# n8n y Hostinger legacy.
N8N_URL=https://n8n-ukzb.onrender.com
HOSTINGER_UPLOAD_URL=https://laizquierdanoticia.com/guardar_imagen_lamina.php
WEBHOOK_TIMEOUT_MS=25000
WEBHOOK_RETRY_ATTEMPTS=1

# Rate limits por IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WEBHOOK_MAX=120

# Usuario inicial para ejecutar npm run db:create-admin contra Supabase.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia_esta_password_larga
ADMIN_NAME=Administrador

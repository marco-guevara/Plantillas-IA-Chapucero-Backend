NODE_ENV=development
PORT=4000
TRUST_PROXY=false

# PostgreSQL local o Supabase.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/laminas_ia
DATABASE_SSL=false
DATABASE_REQUIRED=false
DB_LOGGING=false
WEBHOOK_AUDIT_ENABLED=false

# Dominios permitidos para cookies y frontend con credentials: include.
CORS_ORIGINS=http://localhost:5173,https://tu-frontend.vercel.app
COOKIE_DOMAIN=
COOKIE_SECURE=false
CSRF_REQUIRED=false
REQUIRE_AUTH_FOR_API=true

# Cambiar por secretos largos y distintos en .env.
JWT_ACCESS_SECRET=pon_aqui_un_secreto_largo_para_access_tokens
JWT_REFRESH_SECRET=pon_aqui_un_secreto_largo_para_refresh_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# n8n legacy: no cambiar nombres de webhooks sin revisar docs/N8N_CONTRACTS.md.
N8N_URL=https://n8n-ukzb.onrender.com
HOSTINGER_UPLOAD_URL=https://laizquierdanoticia.com/guardar_imagen_lamina.php
WEBHOOK_TIMEOUT_MS=25000
WEBHOOK_RETRY_ATTEMPTS=1

# Rate limits por IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WEBHOOK_MAX=120

# Usuario inicial opcional para npm run db:create-admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia_esta_password_larga
ADMIN_NAME=Administrador
